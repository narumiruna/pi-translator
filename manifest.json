{
	"manifest_version": 3,
	"name": "Pi Translator",
	"version": "0.1.4",
	"description": "Translate web pages with pi-ai providers while keeping the original text visible.",
	"permissions": ["activeTab", "contextMenus", "scripting", "storage"],
	"host_permissions": [
		"https://youtube.com/*",
		"https://www.youtube.com/*",
		"https://m.youtube.com/*"
	],
	"optional_host_permissions": ["http://*/*", "https://*/*"],
	"background": {
		"service_worker": "src/background/index.js",
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": [
				"https://youtube.com/*",
				"https://www.youtube.com/*",
				"https://m.youtube.com/*"
			],
			"js": ["src/content.js"],
			"run_at": "document_idle"
		}
	],
	"side_panel": {
		"default_path": "src/pdf/index.html"
	},
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"action": {
		"default_title": "Translate this page",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png",
			"48": "icons/icon-48.png",
			"128": "icons/icon-128.png"
		}
	},
	"options_page": "src/options/index.html"
}
