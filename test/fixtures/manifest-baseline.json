{
	"action": {
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png",
			"48": "icons/icon-48.png",
			"128": "icons/icon-128.png"
		},
		"default_title": "Translate this page"
	},
	"contentScript": {
		"matches": [
			"https://youtube.com/*",
			"https://www.youtube.com/*",
			"https://m.youtube.com/*"
		],
		"run_at": "document_idle"
	},
	"description": "Translate web pages with pi-ai providers while keeping the original text visible.",
	"host_permissions": [
		"https://youtube.com/*",
		"https://www.youtube.com/*",
		"https://m.youtube.com/*"
	],
	"manifest_version": 3,
	"name": "Pi Translator",
	"optional_host_permissions": ["http://*/*", "https://*/*"],
	"permissions": ["activeTab", "contextMenus", "scripting", "storage"],
	"sidePanel": {
		"default_path": "sidebar/index.html"
	},
	"version": "0.1.3"
}
