{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!!dist",
			"!!.extension-js",
			"!!e2e-artifacts",
			"!!node_modules"
		]
	},
	"markdown": {
		"formatter": {
			"enabled": false
		}
	},
	"overrides": [
		{
			"includes": ["test/reddit-comment-page.html"],
			"linter": {
				"rules": {
					"a11y": {
						"useSemanticElements": "off"
					}
				}
			}
		}
	]
}
