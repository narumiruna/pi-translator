{
	"name": "pi-translator",
	"version": "0.1.3",
	"private": true,
	"scripts": {
		"changeset": "changeset",
		"version": "changeset version && node scripts/sync-version.mjs && npm install --package-lock-only --ignore-scripts && biome format --write package.json manifest.json",
		"verify:version": "node scripts/sync-version.mjs --check",
		"check": "npx --no-install biome ci && npm run verify:version && npm run lint:modules && npm test && npm run build && npm run verify:build",
		"lint:modules": "find src scripts -type f \\( -name '*.js' -o -name '*.mjs' -o -name '*.cjs' \\) -print0 | xargs -0 -n1 node --check",
		"test": "vitest run",
		"e2e:smoke": "node e2e/extension-smoke.cjs",
		"e2e:mock": "PLAYWRIGHT_MOCK_API=1 node e2e/extension-smoke.cjs",
		"e2e:options": "PLAYWRIGHT_MOCK_API=1 node e2e/options-ui.cjs",
		"e2e:pdf": "PLAYWRIGHT_MOCK_API=1 node e2e/pdf-translation.cjs",
		"e2e:antirez": "node e2e/antirez-comments.cjs",
		"e2e:github": "PLAYWRIGHT_MOCK_API=1 node e2e/github-issue-comments.cjs",
		"e2e:reddit": "PLAYWRIGHT_MOCK_API=1 node e2e/reddit-comments.cjs",
		"e2e:x": "PLAYWRIGHT_MOCK_API=1 node e2e/x-posts.cjs",
		"e2e:syosetu": "node e2e/syosetu-directory.cjs",
		"e2e:youtube": "PLAYWRIGHT_MOCK_API=1 node e2e/youtube-subtitles.cjs",
		"icons": "node scripts/render-icons.mjs",
		"prepare": "husky",
		"dev": "EXTENSION_TELEMETRY_DISABLED=1 extension dev --browser=chrome",
		"build": "EXTENSION_TELEMETRY_DISABLED=1 extension build --browser=chrome",
		"preview": "EXTENSION_TELEMETRY_DISABLED=1 extension preview --browser=chrome",
		"pack": "npm run verify:version && EXTENSION_TELEMETRY_DISABLED=1 extension build --browser=chrome --zip && node scripts/verify-build.mjs",
		"zip": "npm run pack",
		"build:firefox": "EXTENSION_TELEMETRY_DISABLED=1 extension build --browser=firefox",
		"verify:build": "node scripts/verify-build.mjs"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,cjs,cts,mjs,mts,json,jsonc,css,svelte,vue,astro,graphql,gql}": "biome check --write --files-ignore-unknown=true --no-errors-on-unmatched"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@biomejs/biome": "2.6.2",
		"@changesets/cli": "^3.0.3",
		"acorn": "8.19.0",
		"es-module-lexer": "3.0.4",
		"extension": "4.1.35",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"playwright": "1.64.1",
		"vitest": "^5.0.5"
	},
	"type": "module",
	"overrides": {
		"less": "4.8.1",
		"image-size": "2.0.2"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "^1.4.0",
		"@radix-ui/react-icons": "^1.3.2",
		"@radix-ui/themes": "^3.3.0",
		"pdfjs-dist": "6.4.299",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	}
}
